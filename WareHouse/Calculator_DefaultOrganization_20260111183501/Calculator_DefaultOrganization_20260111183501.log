            result = self.calculator.divide(self.first_number, second_number)
        self.display.delete(0, tk.END)
        self.display.insert(0, str(result))
    def clear_display(self):
        self.display.delete(0, tk.END)
if __name__ == "__main__":
    root = tk.Tk()
    app = CalculatorApp(root)
    root.mainloop()
